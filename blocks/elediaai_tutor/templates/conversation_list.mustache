{{!
    @template block_elediaai_tutor/conversation_list

    The list of a user's stored conversations, rendered client-side.

    Example context (json):
    {
        "conversations": [
            {
                "id": 12,
                "conversationid": "abc-123",
                "title": "Assignment help",
                "preview": "What do I need to do this week?",
                "deletelabel": "Delete"
            }
        ]
    }
}}
<ul class="elediaai-chat-history-list" aria-label="{{#str}}history, block_elediaai_tutor{{/str}}">
    {{#conversations}}
        <li class="elediaai-chat-history-item" data-region="conversation"
            data-id="{{id}}" data-conversationid="{{conversationid}}">
            <button type="button" class="elediaai-chat-history-open" data-action="open-conversation">
                <span class="elediaai-chat-history-title">{{#title}}{{title}}{{/title}}{{^title}}{{preview}}{{/title}}</span>
                <span class="elediaai-chat-history-preview">{{preview}}</span>
            </button>
            <button type="button" class="btn btn-icon btn-sm elediaai-chat-iconbtn"
                    data-action="delete-conversation" aria-label="{{deletelabel}}" title="{{deletelabel}}">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
            </button>
        </li>
    {{/conversations}}
</ul>
