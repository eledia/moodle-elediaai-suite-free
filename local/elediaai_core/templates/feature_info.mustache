{{!
    @template local_elediaai_core/feature_info

    Single-feature explainer page. Reuses the icon set from the
    launcher template so the visual identity stays consistent: same
    pastel tile, same SVG, just blown up.

    Context:
      name        - feature title
      description - short feature summary
      hasdetaildescription - true when a longer benefit text is present
      detaildescription - decision-oriented benefit text
      benefittitle - heading for the benefit card
      haskeyfeatures - true when key feature bullets are present
      keyfeaturestitle - heading for key feature list
      keyfeatures - list of {text}
      origintitle - heading for source/credits
      originintro - short intro for source/credits
      originrows - list of {title, authors, url, note}
      haslaunchurl - true when the feature has a standalone entry point
      launchurl - URL of the feature entry point
      launchtitle - heading for the launch card
      launchdescription - short text for the launch card
      launchlabel - CTA label for the launch card
      hasinstallurl - true when a missing plugin can be installed from a source URL
      installurl - URL to the plugin source/install page
      installtitle - heading for the install card
      installdescription - short text for the install card
      installlabel - CTA label for the install card
      comingsoon  - true if the feature is on the roadmap
      actionid    - descriptor id (used as data-actionid for pastel)
      statuslabel - localised "Verfügbar" / "In Vorbereitung"
      icon_<name> - flag for the matching SVG block
}}
<section class="lh-ai-feature" data-actionid="{{actionid}}">
    <div class="lh-ai-feature__card">
        <div class="lh-ai-feature__icon" aria-hidden="true">
            {{#icon_circle_question}}<svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2-3 4"/><path d="M12 17h.01"/></svg>{{/icon_circle_question}}
            {{#icon_pen_fancy}}<svg viewBox="0 0 24 24" focusable="false"><path d="m21 3-2.7 2.7"/><path d="M14.5 7.5 4 18l-1 4 4-1 10.5-10.5"/><path d="m12 10 2 2"/><circle cx="19" cy="5" r="2"/></svg>{{/icon_pen_fancy}}
            {{#icon_comments}}<svg viewBox="0 0 24 24" focusable="false"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg>{{/icon_comments}}
            {{#icon_comment_dots}}<svg viewBox="0 0 24 24" focusable="false"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/></svg>{{/icon_comment_dots}}
            {{#icon_magnifying_glass}}<svg viewBox="0 0 24 24" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>{{/icon_magnifying_glass}}
            {{#icon_book_plus}}<svg viewBox="0 0 24 24" focusable="false"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M9 6h6"/><path d="M12 4v6"/></svg>{{/icon_book_plus}}
            {{#icon_puzzle_piece}}<svg viewBox="0 0 24 24" focusable="false"><path d="M19.4 7.3h-2.1a2.1 2.1 0 1 1 0-4.2h2.1a1.6 1.6 0 0 1 1.6 1.6v14.6a1.6 1.6 0 0 1-1.6 1.6H4.8a1.6 1.6 0 0 1-1.6-1.6v-2.1a2.1 2.1 0 1 0 0-4.2V4.7a1.6 1.6 0 0 1 1.6-1.6h5.4"/></svg>{{/icon_puzzle_piece}}
            {{#icon_toolbox}}<svg viewBox="0 0 24 24" focusable="false"><path d="M10 6V5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v1"/><path d="M3 10h18"/><rect width="18" height="14" x="3" y="6" rx="2"/><path d="M12 10v4"/></svg>{{/icon_toolbox}}
            {{#icon_compass}}<svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10"/><path d="m16.2 7.8-2.1 6.3-6.3 2.1 2.1-6.3z"/></svg>{{/icon_compass}}
            {{#icon_languages}}<svg viewBox="0 0 24 24" focusable="false"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></svg>{{/icon_languages}}
            {{#icon_graduation_cap}}<svg viewBox="0 0 24 24" focusable="false"><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/><path d="m21.42 10.922-9.31-3.93a1 1 0 0 0-.834 0L1.42 10.92a1 1 0 0 0 0 1.832l9.83 4.16a1 1 0 0 0 .834 0l9.836-4.158a1 1 0 0 0 0-1.832z"/></svg>{{/icon_graduation_cap}}
            {{#icon_clipboard_list}}<svg viewBox="0 0 24 24" focusable="false"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>{{/icon_clipboard_list}}
        </div>

        <div class="lh-ai-feature__copy">
            <span class="lh-ai-feature__status {{#comingsoon}}lh-ai-feature__status--coming{{/comingsoon}}{{^comingsoon}}lh-ai-feature__status--ready{{/comingsoon}}">{{statuslabel}}</span>
            <h2 class="lh-ai-feature__name">{{name}}</h2>
            <p class="lh-ai-feature__desc">{{description}}</p>
        </div>
    </div>

    {{#hasdetaildescription}}
    <div class="lh-ai-feature__benefit">
        <h3 class="lh-ai-feature__benefit-title">{{benefittitle}}</h3>
        <p class="lh-ai-feature__benefit-copy">{{detaildescription}}</p>
    </div>
    {{/hasdetaildescription}}

    {{#haskeyfeatures}}
    <div class="lh-ai-feature__benefit lh-ai-feature__keyfeatures">
        <h3 class="lh-ai-feature__benefit-title">{{keyfeaturestitle}}</h3>
        <ul class="lh-ai-feature__keyfeatures-list">
            {{#keyfeatures}}
            <li>{{text}}</li>
            {{/keyfeatures}}
        </ul>
    </div>
    {{/haskeyfeatures}}

    <div class="lh-ai-feature__benefit lh-ai-feature__origins">
        <h3 class="lh-ai-feature__benefit-title">{{origintitle}}</h3>
        <p class="lh-ai-feature__benefit-copy">{{originintro}}</p>
        <div class="lh-ai-feature__origin-list">
            {{#originrows}}
            <div class="lh-ai-feature__origin">
                <div class="lh-ai-feature__origin-main">
                    <a class="lh-ai-feature__origin-title" href="{{url}}">{{title}}</a>
                    <span class="lh-ai-feature__origin-authors">{{authors}}</span>
                </div>
                <p class="lh-ai-feature__origin-note">{{note}}</p>
            </div>
            {{/originrows}}
        </div>
    </div>

    {{#haslaunchurl}}
    <div class="lh-ai-feature__launch">
        <div class="lh-ai-feature__launch-copy">
            <h3 class="lh-ai-feature__benefit-title">{{launchtitle}}</h3>
            <p class="lh-ai-feature__benefit-copy">{{launchdescription}}</p>
        </div>
        <a class="lh-plugin-btn lh-plugin-btn--open lh-ai-feature__launch-action" href="{{launchurl}}">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            {{launchlabel}}
        </a>
    </div>
    {{/haslaunchurl}}

    {{#hasinstallurl}}
    <div class="lh-ai-feature__launch">
        <div class="lh-ai-feature__launch-copy">
            <h3 class="lh-ai-feature__benefit-title">{{installtitle}}</h3>
            <p class="lh-ai-feature__benefit-copy">{{installdescription}}</p>
        </div>
        <a class="lh-plugin-btn lh-plugin-btn--open lh-ai-feature__launch-action" href="{{installurl}}">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lucide"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            {{installlabel}}
        </a>
    </div>
    {{/hasinstallurl}}
</section>

<style>
.lh-ai-feature {
    margin: 1rem 0 0;
    width: 100%;
}
.lh-ai-feature__card {
    align-items: flex-start;
    background: var(--lh-bg-white);
    border: 1px solid var(--lh-border);
    border-radius: var(--lh-radius-sm);
    box-shadow: var(--lh-shadow-card);
    display: flex;
    gap: 1rem;
    min-width: 0;
    padding: 1rem;
    width: 100%;
}
.lh-ai-feature__icon {
    align-items: center;
    background: var(--eai-ai-wash);
    border-radius: var(--lh-radius-sm);
    color: var(--eai-ai);
    display: grid;
    flex: 0 0 auto;
    height: 3.5rem;
    place-items: center;
    width: 3.5rem;
}
.lh-ai-feature__icon svg {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
}
.lh-ai-feature__copy { flex: 1 1 auto; min-width: 0; }
.lh-ai-feature__status {
    border-radius: var(--eai-radius-pill);
    display: inline-block;
    font-size: var(--font-size-caption);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
    padding: 0.15rem 0.6rem;
    text-transform: uppercase;
}
.lh-ai-feature__status--ready { background: var(--eai-success-wash); color: var(--eai-success); }
.lh-ai-feature__status--coming { background: var(--eai-warning-wash); color: var(--eai-warning); }
.lh-ai-feature__name {
    color: var(--lh-text);
    font-size: var(--font-size-h3);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 0.5rem;
}
.lh-ai-feature__desc {
    color: var(--lh-muted);
    font-size: var(--font-size-body);
    line-height: 1.5;
    margin: 0;
    max-width: 42rem;
}
.lh-ai-feature__benefit {
    background: var(--lh-bg-white);
    border: 1px solid var(--lh-border);
    border-radius: var(--lh-radius-sm);
    box-shadow: var(--lh-shadow-card);
    margin-top: 1rem;
    padding: 1rem;
}
.lh-ai-feature__benefit-title {
    color: var(--lh-text);
    font-size: var(--font-size-h4);
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 0.5rem;
}
.lh-ai-feature__benefit-copy {
    color: var(--lh-muted);
    font-size: var(--font-size-body);
    line-height: 1.55;
    margin: 0;
    max-width: 56rem;
}
.lh-ai-feature__keyfeatures-list {
    color: var(--lh-muted);
    display: grid;
    gap: 0.5rem;
    line-height: 1.5;
    margin: 0;
    max-width: 58rem;
    padding-left: 1.15rem;
}
.lh-ai-feature__keyfeatures-list li::marker {
    color: var(--lh-primary);
}
.lh-ai-feature__origin-list {
    display: grid;
    gap: .75rem;
    margin-top: .85rem;
}
.lh-ai-feature__origin {
    background: var(--eai-bg);
    border: 1px solid var(--lh-border);
    border-radius: var(--lh-radius-sm);
    padding: .8rem;
}
.lh-ai-feature__origin-main {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: .35rem .75rem;
}
.lh-ai-feature__origin-title {
    font-weight: 800;
}
.lh-ai-feature__origin-authors {
    color: var(--lh-muted);
    font-size: var(--font-size-body);
    font-weight: 700;
}
.lh-ai-feature__origin-note {
    color: var(--lh-muted);
    line-height: 1.5;
    margin: .35rem 0 0;
}
.lh-ai-feature__launch {
    align-items: center;
    background: var(--lh-bg-white);
    border: 1px solid var(--lh-border);
    border-radius: var(--lh-radius-sm);
    box-shadow: var(--lh-shadow-card);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 1rem;
    padding: 1rem;
}
.lh-ai-feature__launch-copy {
    min-width: 0;
}
.lh-ai-feature__launch-action {
    flex: 0 0 auto;
    white-space: nowrap;
}
/* Match the launcher pastels. */
.lh-ai-feature[data-actionid="audit"] .lh-ai-feature__icon,
.lh-ai-feature[data-actionid="translate"] .lh-ai-feature__icon { background: #e6f4ff; color: #0a6ea4; }
.lh-ai-feature[data-actionid="activityfilter"] .lh-ai-feature__icon,
.lh-ai-feature[data-actionid="aifeedback"] .lh-ai-feature__icon,
.lh-ai-feature[data-actionid="h5pauthor"] .lh-ai-feature__icon,
.lh-ai-feature[data-actionid="qtype_aitext"] .lh-ai-feature__icon,
.lh-ai-feature[data-actionid="questiongenerator"] .lh-ai-feature__icon { background: #fff5e6; color: #9a5c00; }
.lh-ai-feature[data-actionid="coursegen"] .lh-ai-feature__icon,
.lh-ai-feature[data-actionid="strategyhelper"] .lh-ai-feature__icon,
.lh-ai-feature[data-actionid="tactics"] .lh-ai-feature__icon { background: #f1ecff; color: #5b3fa6; }
.lh-ai-feature[data-actionid="aichat"] .lh-ai-feature__icon,
.lh-ai-feature[data-actionid="tutor"] .lh-ai-feature__icon,
.lh-ai-feature[data-actionid="tutorpremium"] .lh-ai-feature__icon { background: #e8fff3; color: #157f3f; }
@media (max-width: 640px) {
    .lh-ai-feature__card { flex-direction: column; gap: 1rem; padding: 1.25rem; }
    .lh-ai-feature__launch { align-items: flex-start; flex-direction: column; }
    .lh-ai-feature__launch-action { white-space: normal; }
}
</style>
