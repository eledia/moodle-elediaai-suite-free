{{!
    @template local_elediaai_sources/status_summary

    Course status and counters at the head of the activity page (REQ-014).
    Rendered by the page and again by the status refresh.

    Context variables required for this template:
    * coursestatus - processing, partial, indexed, error or none.
    * coursestatuslabel - The course status in words.
    * countindexed - Activities confirmed in the index.
    * countprocessing - Activities accepted, not yet confirmed.
    * counterror - Activities that failed.
    * statusunavailable - Whether the status of documents in flight could not be read.
    * hasinflight - Whether documents are still being processed.
    * lastcheckedtext - When the status was last read, or empty.

    Example context (json):
    {
        "coursestatus": "processing",
        "coursestatuslabel": "Being processed",
        "countindexed": 4,
        "countprocessing": 2,
        "counterror": 1,
        "statusunavailable": false,
        "hasinflight": true,
        "lastcheckedtext": "Last checked: Tuesday, 24 November 2026, 10:15"
    }
}}
<p class="les-activities-coursestatus mb-1">
    <strong>{{#str}} activities_coursestatus, local_elediaai_sources {{/str}}</strong>
    <span data-region="coursestatus" data-status="{{coursestatus}}">{{coursestatuslabel}}</span>
</p>
<ul class="list-inline les-activities-counts mb-1">
    <li class="list-inline-item">{{#str}} activities_summary_indexed, local_elediaai_sources, {{countindexed}} {{/str}}</li>
    <li class="list-inline-item">{{#str}} activities_summary_processing, local_elediaai_sources, {{countprocessing}} {{/str}}</li>
    <li class="list-inline-item">{{#str}} activities_summary_error, local_elediaai_sources, {{counterror}} {{/str}}</li>
</ul>
{{#statusunavailable}}
    <div class="alert alert-warning mb-2" role="status">
        {{#str}} activities_statusunavailable_notice, local_elediaai_sources {{/str}}
    </div>
{{/statusunavailable}}
{{^hasinflight}}
    <p class="small text-muted mb-1">{{#str}} activities_allfinal, local_elediaai_sources {{/str}}</p>
{{/hasinflight}}
{{#lastcheckedtext}}
    <p class="small text-muted mb-0">{{lastcheckedtext}}</p>
{{/lastcheckedtext}}
